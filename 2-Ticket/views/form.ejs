<h1>Tạo vé mới</h1>
<a href="/">Quay lại</a>

<form action="/tickets/upsert<%= ticket ? `/${ticket.ticketId}` : "" %>" method="POST" enctype="multipart/form-data"> 
  <div
    style="display: flex; flex-direction: column; gap: 1rem; margin: 1rem auto"
  >
    <input type="text" name="eventName" value="<%= ticket?.eventName %>" placeholder="eventName">
    <input type="text" name="holderName" value="<%= ticket?.holderName %>" placeholder="holderName">
    
    <div>
      <label>category</label>
      <select name="category">
        <option value="Standard" <%= ticket?.category === "Standard" ? "selected" : "" %>>Standard</option>
        <option value="VIP" <%= ticket?.category === "VIP" ? "selected" : "" %>>VIP</option>
        <option value="VVIP" <%= ticket?.category === "VVIP" ? "selected" : "" %>>VVIP</option>
      </select>
    </div>

    <input type="text" name="quantity" value="<%= ticket?.quantity %>" placeholder="quantity">
    <input type="text" name="pricePerTicket" value="<%= ticket?.pricePerTicket %>" placeholder="pricePerTicket">
    
    <div>
      <label>status</label>
      <select name="status">
        <option value="Upcoming" <%= ticket?.status === "Upcoming" ? "selected" : "" %>>Upcoming</option>
        <option value="Sold" <%= ticket?.status === "Sold" ? "selected" : "" %>>Sold</option>
        <option value="Cancelled" <%= ticket?.status === "Cancelled" ? "selected" : "" %>>Cancelled</option>
      </select>
    </div>

    <input type="date" name="eventDate" value="<%= ticket?.eventDate %>" placeholder="eventDate">
    <input type="file" name="image">

    <button type="submit">Lưu</button>

  </div>
</form>

<% if (typeof error !== "undefined" && error) { %>
  <p><%= error %></p>
<% } %>